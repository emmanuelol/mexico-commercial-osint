# INEGI State Code (01-32). 11 = Guanajuato, 09 = CDMX, 14 = Jalisco, 19 = Nuevo León
INEGI_STATE_CODE=11

# Target coordinates (defaults to downtown León, Gto — NOT a real branch)
TARGET_LAT=21.1221
TARGET_LON=-101.6826

# Search radius in kilometers
RADIUS_KM=3.0

# Minimum employee strata (one of: "0 a 5 personas", "6 a 10 personas", 
# "11 a 30 personas", "31 a 50 personas", "51 a 100 personas", 
# "101 a 250 personas", "251 y más personas")
MIN_EMPLOYEES_STRATA=11 a 30 personas

# DuckDuckGo rate limit (seconds between queries)
DDG_SLEEP_SEC=2.0
